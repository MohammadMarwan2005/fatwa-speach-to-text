# Fatwa transcript settings. Copy this file to config.env (run.sh does it for you).
# config.env stays on this computer: the page in the browser never sees the key.

# Your Anthropic API key (console.anthropic.com > API keys). Leave empty to use free mode only.
ANTHROPIC_API_KEY=

# Optional. Default correction model: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5, or none.
# CLAUDE_MODEL=claude-opus-5-5

# Optional. Default effort: low, medium or high.
# CLAUDE_EFFORT=medium

# Optional. Whisper model: large-v3 (best accuracy) or large-v3-turbo (faster, smaller download).
# WHISPER_MODEL=large-v3

# Optional. Set to off to keep Whisper on the CPU even when a GPU is available.
# WHISPER_GPU=on

# Optional. CPU threads for Whisper (default: one per physical core).
# WHISPER_THREADS=4

# Optional. Port for the local page (default 8765).
# PORT=8765

# Optional. Use a specific Whisper model file instead of the downloaded ones.
# WHISPER_MODEL_PATH=/path/to/ggml-model.bin
